rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAuthorized() {
      return isSignedIn() && (
        request.auth.token.email == 'desarrollogianduia@gmail.com' ||
        request.auth.token.email == 'mantenimientogianduia@gmail.com' ||
        request.auth.token.email == 'guicarrozzo@gmail.com' ||
        request.auth.token.email == 'noconformidades@gianduia.com.ar'
      );
    }

    match /{document=**} {
      allow read, write: if isAuthorized();
    }
  }
}
